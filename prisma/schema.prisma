generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id            String   @id @default(cuid())
  title         String
  description   String?
  location      String
  city          String
  state         String
  country       String   @default("India")
  price         Float
  currency      String   @default("INR")
  beds          Int?
  baths         Int?
  sqft          Float?
  propertyType  String
  listingType   String
  reraNumber    String?
  aiScore       Float?
  images        String[]
  amenities     String[]
  documents     Json     @default("[]")
  status        String   @default("pending")
  featured      Boolean  @default(false)
  verified      Boolean  @default(false)
  reraVerified  Boolean  @default(false)
  realPhotos    Boolean  @default(false)
  accuratePrice Boolean  @default(false)
  ownerConsent  Boolean  @default(false)
  // Granular honesty-first verification checks shown via the PropKnown Verified stamp —
  // shape matches components/ui/VerificationBadge.tsx's VerificationFlags.
  verificationFlags Json @default("{}")
  // Legal Safety Checklist (Feature: Legal Shield) — shape matches lib/legalShield.ts's
  // LegalChecklist (Record<itemKey, "verified"|"pending"|"na">). Admin-set only.
  legalChecklist Json @default("{}")
  legalNotes     String?
  // Construction Progress Tracker — array of { id, title, note, photoUrl?, date, pctComplete }
  // milestones, newest last. Only shown for listingType/status "under construction".
  constructionMilestones Json @default("[]")
  constructionPct        Int?
  expectedCompletion     String?
  // NRI virtual tour — external video URL (YouTube/Drive link), admin-provided
  videoTourUrl   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  leads         Lead[]

  // Enterprise CRM: AI scoring (Section 5 / Section G-Q) -- aiScore above is reused as the
  // headline investment score; these are the supporting figures computeMarketIntel() and the
  // legal-heuristic scorer produce alongside it. All nullable -- unset until "Score this
  // property" is run, never fabricated.
  aiPricePrediction Json?
  legalScore        Float?
  roiAnalysis       Json?
  aiScoredAt        DateTime?

  siteVisits    SiteVisit[]
  bookings      Booking[]

  @@index([status])
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String
  message      String?
  source       String
  // First-touch attribution (Task G): where the visitor first came from, from the 90-day
  // first-party pk_ft cookie. Nullable -- older leads and direct visits have none.
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmContent   String?
  referrer     String?
  landingPage  String?
  status       String    @default("new")
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id])
  notes        String?
  assignedTo   String?
  followUpDate DateTime?
  leadValue    Float?
  tags         String[]
  timeline     Json      @default("[]")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Documents attached in Lead Detail -- same JSON-array-of-UploadedFile-id pattern already
  // used by PropertySubmission's photoIds/videoIds/docIds, not a real FK (UploadedFile has no
  // relation column; every existing usage in this codebase resolves IDs manually instead).
  docIds       String    @default("[]") @db.Text

  // Enterprise CRM: AI Lead Scoring (Section 3). All nullable, all written only by the
  // "Score this lead" action -- never auto-populated, never fabricated. recommendedPropertyId
  // is a soft reference (Property IDs live in a separate space from PropertySubmission's, same
  // caveat as propertyId above), resolved for display, not a DB-enforced FK.
  leadScore              Float?
  buyingIntent           String?
  financialStrength      String?
  urgencyLevel           String?
  conversionProbability  Float?
  bestFollowUpTime       String?
  recommendedPropertyId  String?
  nextBestAction         String?
  aiSummary              String?
  aiScoredAt             DateTime?

  // Channel Partner attribution (Section 9) -- optional, only set when a lead was shared by
  // a registered partner.
  partnerId    String?
  partner      ChannelPartner? @relation(fields: [partnerId], references: [id])

  siteVisits   SiteVisit[]
  bookings     Booking[]

  // Report-request leads (Task 2: "Email me the full report") -- which tool + location the
  // visitor searched, so the follow-up sequence and Hot-lead alert can reference it. All
  // nullable/defaulted: existing leads are unaffected.
  reportContext     Json?
  marketingOptOut   Boolean   @default(false)
  sequenceStep      Int       @default(0) // 0 none, 1 report sent, 2 day-2 sent, 3 day-5 sent (done)
  sequenceStartedAt DateTime?
  hotAlertAt        DateTime?

  emailLogs    EmailLog[]

  @@index([status])
  @@index([assignedTo])
  @@index([sequenceStep])
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("agent")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  resetTokens  PasswordResetToken[]
}

// Forgot-password tokens for /admin and /crm (all roles). The raw token is only ever emailed
// to the user -- tokenHash (sha256 of the raw token) is what's stored, so a DB read alone
// never yields a usable token. Single-use (`used`) and short-lived (`expiresAt`).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  used      Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UploadedFile {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  sizeBytes Int
  data      String   @db.Text
  docType   String?
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BuyerUser {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  createdAt    DateTime   @default(now())
  favorites    Favorite[]
  alerts       Alert[]
  // M2: set when the customer proves the address with an emailed one-time code. Only verified
  // addresses see their Fair-Price Reports (stored as leads keyed by email) in My PropKnown.
  emailVerifiedAt DateTime?
  savedSearches   SavedSearch[]
  priceWatches    PriceWatch[]
  documentChecks  DocumentCheck[]
}

// M2: one-time login/sign-up codes for customer accounts. Only a keyed hash of the code is
// stored; codes expire after 10 minutes and allow 5 attempts.
model BuyerOtp {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
  @@map("buyer_otps")
}

// M2: a customer's saved search (re-opened from My PropKnown). kind: listings | area | project.
model SavedSearch {
  id        String    @id @default(cuid())
  buyerId   String
  buyer     BuyerUser @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  name      String
  kind      String
  path      String // the page + query string to re-open, e.g. /buy?city=Hyderabad&type=Apartment
  createdAt DateTime  @default(now())

  @@index([buyerId])
  @@map("saved_searches")
}

// M2: price watchlist. A daily job compares the cached (sourced, dated) price with lastPrice and
// emails the customer when it moves by 3% or more. kind: area | project.
model PriceWatch {
  id             String    @id @default(cuid())
  buyerId        String
  buyer          BuyerUser @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  watchKey       String // kind|location|project|type, lower-case -- one watch per thing per customer
  kind           String
  location       String
  projectName    String?
  propertyType   String    @default("apartment")
  lastPrice      Float?
  lastCapturedAt DateTime?
  lastNotifiedAt DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@unique([buyerId, watchKey])
  @@index([active])
  @@map("price_watches")
}

model Favorite {
  id           String    @id @default(cuid())
  buyerId      String
  buyer        BuyerUser @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  listingId    String
  title        String
  priceDisplay String?
  location     String?
  image        String?
  createdAt    DateTime  @default(now())

  @@unique([buyerId, listingId])
}

model Alert {
  id        String    @id @default(cuid())
  buyerId   String
  buyer     BuyerUser @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  city      String?
  propType  String?
  minBudget Float?
  maxBudget Float?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model PropertySubmission {
  id           String   @id @default(cuid())
  title        String
  propType     String
  bhk          String?
  size         String?
  sizeUnit     String?
  priceDisplay String
  city         String
  area         String
  description  String   @db.Text
  features     String?
  reraNumber   String?
  ownerName    String
  ownerPhone   String
  ownerEmail   String
  photoIds     String   @default("[]") @db.Text
  // Keyed by photoId (from photoIds above), not array position -- { [photoId]: "caption text" }.
  // Owner-written at submission time, optional. Used as the photo's alt text in the gallery
  // instead of a generic repeated title/description when present for that specific photo.
  photoCaptions Json    @default("{}")
  videoIds     String   @default("[]") @db.Text
  videoUrls    String   @default("[]") @db.Text
  docIds       String   @default("[]") @db.Text
  status       String   @default("pending")
  rejectReason String?
  adminNotes   String?
  // Granular honesty-first verification checks shown via the PropKnown Verified stamp —
  // shape matches components/ui/VerificationBadge.tsx's VerificationFlags. Admin-toggled
  // in the submission review UI; never auto-set to true.
  verificationFlags Json @default("{}")
  // Legal Safety Checklist (Feature: Legal Shield) — shape matches lib/legalShield.ts's
  // LegalChecklist (Record<itemKey, "verified"|"pending"|"na">). Admin-set only.
  legalChecklist Json @default("{}")
  legalNotes     String?
  // Construction Progress Tracker — array of { id, title, note, photoUrl?, date, pctComplete }
  // milestones, newest last. Only shown for propType/status implying under-construction.
  constructionMilestones Json @default("[]")
  constructionPct        Int?
  expectedCompletion     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Server-side counter for the anonymous "3 free AI checks" limit (AI Intelligence, Price
// Reality Check). Keyed by a random ID stored in an httpOnly cookie -- a real database
// counter rather than in-memory, since in-memory state isn't reliably shared across
// serverless invocations and would make the limit meaningless in production. Logged-in
// buyers never touch this table at all (see lib/usageLimit.ts).
model AnonymousUsage {
  id        String   @id
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Dedicated free-search counter + lead-gate flag for the AI Intelligence page only --
// deliberately separate from AnonymousUsage (shared by Price Reality Check) so a visitor's
// AI Intelligence budget isn't silently eaten by using a different tool. Keyed the same way:
// a random ID in an httpOnly cookie. Once `registered` is true (visitor submitted the
// lead-capture gate), they get unlimited searches from then on -- see lib/aiIntelGate.ts.
model AiIntelUsage {
  id         String   @id
  count      Int      @default(0)
  registered Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// IP-keyed fallback counter, checked alongside AiIntelUsage's cookie-keyed one -- a visitor
// is only let through if BOTH are under budget (or either is registered). Cookie-only tracking
// resets for free the moment someone clears cookies or opens a private window; this closes
// that specific gap without pretending to be a hard, unbeatable wall (a shared office/NAT IP,
// VPN, or mobile carrier CGNAT can still legitimately share one IP across many real visitors --
// same honesty-over-security-theater tradeoff already used elsewhere in this file).
model AiIntelUsageByIp {
  ip         String   @id
  count      Int      @default(0)
  registered Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Precomputed AI Intelligence results for the "hot market" locations (lib/hotMarkets.ts) x all
// property types, refreshed every few hours by app/api/cron/refresh-hot-markets. Lets the
// server-rendered /ai-intelligence/[city]/[area] overview pages render instantly with zero live
// Gemini/Tavily calls and be crawled by Google without any JS or gate involved, and lets
// app/api/market-intel/overview serve a full multi-type location overview for free on a cache
// hit. `id` is a deterministic composite key so refreshing is always a plain upsert, never a
// duplicate row. `data` stores the exact same normalised shape computeMarketIntel() always
// returns (lib/marketIntel.ts) -- this table is a cache of that function's output, not a
// separately-shaped summary.
model HotMarketCache {
  id           String   @id // `${city}|${area}|${propertyType}`
  city         String
  area         String
  propertyType String
  unit         String
  data         Json
  updatedAt    DateTime @updatedAt

  @@index([city, area])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enterprise CRM extension (feature/crm-enterprise-full) -- everything below this line is
// additive: new tables only, plus the nullable fields added to Property/Lead above. Nothing
// existing was changed or removed.
// ─────────────────────────────────────────────────────────────────────────────

// Site Visit Module (Section 6) -- basic scheduling/status/feedback tonight. Deliberately no
// live GPS tracking field (mapsLink is a plain "open in Google Maps" deep link, not a tracked
// device location) and no aiSummary field yet -- both deferred per the plan.
model SiteVisit {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id])
  scheduledAt DateTime
  assignedTo  String?
  status      String    @default("scheduled") // scheduled | completed | cancelled | no_show
  feedback    String?
  rating      Int?
  mapsLink    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
}

// Booking Module (Section 7) -- basic record + status/timeline tonight. Deliberately no
// agreement/cancellation/refund fields -- that's real financial workflow logic, excluded from
// tonight's scope on purpose (see plan).
model Booking {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  amount     Float?
  status     String    @default("initiated") // initiated | confirmed | cancelled
  timeline   Json      @default("[]")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([leadId])
}

// Channel Partner Module (Section 9) -- registration + lead attribution tonight. Commission
// model exists for the future payout-tracking feature but nothing writes to it yet -- no
// commission calculation logic is built in this pass (financial logic, deliberately excluded).
model ChannelPartner {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  company   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  leads       Lead[]
  commissions Commission[]
}

model Commission {
  id        String         @id @default(cuid())
  partnerId String
  partner   ChannelPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  leadId    String?
  amount    Float?
  status    String         @default("pending")
  createdAt DateTime       @default(now())
}

// Marketing (Section 10) -- real campaign records with manually-entered spend, so cost-per-lead
// can be computed from real numbers (spend ÷ real Lead.source-attributed count) rather than
// fabricated. No landing-page builder or automated spend tracking.
model Campaign {
  id        String    @id @default(cuid())
  name      String
  channel   String // "meta" | "google_ads" | "youtube" | "other"
  spend     Float?
  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Audit Trail (Section 14) -- scoped to new Enterprise CRM mutations only tonight (Settings
// changes, AI scoring runs, new role/user creation). Deliberately not retrofitted onto every
// pre-existing route -- see plan for why.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── Settings (Section 15) -- real, persisted, editable config, replacing the previously
// static/hardcoded admin Settings tab. ───────────────────────────────────────────────────────

model CompanySettings {
  id          String   @id @default("singleton")
  companyName String?
  founderName String?
  whatsapp    String?
  email       String?
  address     String?
  // Public "we will call you back" wording on lead forms (admin-editable). Empty = default.
  callbackText String?
  updatedAt   DateTime @updatedAt
}

model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  builder   String?
  city      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Builder {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Bank {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model PropertyTypeConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// API Keys (Section 15) -- Meta/Google Ads/etc credentials. encryptedValue is AES-encrypted
// JSON (see lib/apiCredentials.ts), never the raw secret -- the API route that reads this for
// display purposes only ever returns a masked placeholder, never the decrypted value, per the
// "never display plaintext once saved" requirement.
model ApiCredential {
  id           String    @id @default(cuid())
  provider     String    @unique // "meta" | "google_ads" | "youtube"
  encryptedValue String  @db.Text
  status       String    @default("not_connected") // not_connected | connected | error
  lastTestedAt DateTime?
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Employee Training Tracker (new feature) -- links + completion tracking only, deliberately
// no quiz/certification system. TrainingItem is admin-authored content (a link, not a file --
// video/document links live wherever the admin hosts them, e.g. YouTube/Google Drive).
// TrainingAssignment is per-employee (assigneeId references AdminUser.id, not enforced as a
// DB-level FK since AdminUser rows can be soft-deleted/deactivated and we want assignment
// history to survive that, same reasoning as Lead.assignedTo being a bare string elsewhere).
// ─────────────────────────────────────────────────────────────────────────────

model TrainingItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  link        String
  linkType    String   @default("other") // "video" | "document" | "other" -- display hint only
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments TrainingAssignment[]
}

model TrainingAssignment {
  id             String       @id @default(cuid())
  trainingItemId String
  trainingItem   TrainingItem @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)
  assigneeId     String       // AdminUser.id -- soft reference, see note above
  assigneeName   String       // denormalised at assignment time so completion dashboards don't
                               // break if the assignee is later deactivated/renamed
  completed      Boolean      @default(false)
  completedAt    DateTime?
  assignedAt     DateTime     @default(now())

  @@unique([trainingItemId, assigneeId])
  @@index([assigneeId])
}

model RolePermission {
  id        String   @id @default(cuid())
  role      String   // Role key from lib/roles.ts (e.g. "manager", "sales_executive")
  area      String   // Feature-area key from lib/permissionAreas.ts (e.g. "site_visits")
  allowed   Boolean
  updatedAt DateTime @updatedAt

  @@unique([role, area])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shared AI engine (lib/engine) -- one cached price per (location, property type), read by
// every AI feature so the same place shows the same number everywhere. Stored in the
// property type's canonical unit (apartment/villa/house/commercial: sqft, plot: sqyard,
// agriculture: acres) and converted on the way out. `data` is computeMarketIntel()'s exact
// normalised output. previousPrice/previousAt keep the prior refresh's figure so Content
// Studio can find the biggest real movers without a separate history table.
// ─────────────────────────────────────────────────────────────────────────────
model LocationMarketCache {
  id            String    @id // `${locationKey}|${propertyType}`
  locationKey   String
  locationName  String
  city          String?
  propertyType  String
  unit          String
  currency      String
  pricePerUnit  Float
  data          Json
  previousPrice Float?
  previousAt    DateTime?
  fetchedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([locationKey])
  @@index([fetchedAt])
  @@map("location_market_cache")
}

// Every AI query from every tool (price check, AI intel, legal shield, chat, voice...) --
// feeds the admin "AI Demand" page. location is what the visitor typed; locationKey is the
// engine's canonical key so "Kokapet" and "kokapet, hyderabad" count as one locality.
model AiQuery {
  id           String   @id @default(cuid())
  tool         String
  location     String?
  locationKey  String?
  propertyType String?
  result       String // ok | unavailable | timeout | error | no_location
  pricePerUnit Float?
  unit         String?
  currency     String?
  cached       Boolean  @default(false)
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([locationKey])
  @@map("ai_queries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Sales Champions Leaderboard (new feature) -- no new table needed. Ranking is computed live
// from real Lead data (status="won", assignedTo, leadValue) via the same aggregation pattern
// already used by the Executive Dashboard's "Top Sales Executives" card -- see
// app/api/crm/leaderboard/route.ts. Kept here as a note so the absence of a Leaderboard model
// isn't mistaken for an oversight.
// ─────────────────────────────────────────────────────────────────────────────

// Every email the automation sends (report, sequence steps, alerts, newsletter, listing
// decisions) -- powers the admin "Sequences" view. status: sent | failed | skipped (e.g.
// unsubscribed). Never stores the email body, only what was sent to whom and when.
model EmailLog {
  id         String   @id @default(cuid())
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  to         String
  kind       String // report | day2 | day5 | hot_alert | newsletter | listing_approved | listing_rejected | listing_verify | test
  subject    String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@index([to, kind])
  @@map("email_log")
}

// Addresses that clicked "unsubscribe" -- checked before every marketing email, regardless of
// which lead record the address appears on.
model EmailSuppression {
  email     String   @id
  reason    String   @default("unsubscribe")
  createdAt DateTime @default(now())

  @@map("email_suppressions")
}

// Daily outbound API usage for the admin "Engine Health" page: one row per provider per UTC day
// (gemini | tavily | rapidapi). calls = every request made, errors = non-2xx / timeouts,
// rateLimited = 429/432 quota responses. Incremented by lib/engine/usage.ts.
model ApiUsage {
  day         String   // YYYY-MM-DD (UTC)
  provider    String
  calls       Int      @default(0)
  errors      Int      @default(0)
  rateLimited Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([day, provider])
  @@map("api_usage")
}

// Official government guidance / market values ("circle rates"), entered BY HAND from the
// published source (Telangana IGRS first). Never AI-generated: every row carries the source
// it was copied from and the date the rate took effect. Shown next to the AI estimate as
// "Govt guidance value".
model GuidanceRate {
  id            String   @id @default(cuid())
  state         String   // e.g. "Telangana"
  district      String?
  mandal        String?
  locality      String   // village / locality name as published
  localityKey   String   // the engine locationKey, e.g. "hyderabad/kokapet" (lib/engine resolveLocation)
  propertyType  String   // apartment | villa | house | plot | commercial | agriculture
  unit          String   // sqft | sqyard | acres
  ratePerUnit   Float
  currency      String   @default("INR")
  sourceName    String   // e.g. "IGRS Telangana -- Market Value Guidelines"
  sourceUrl     String?
  effectiveDate DateTime // date the published rate took effect
  notes         String?
  enteredBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([localityKey, propertyType])
  @@index([state])
  @@map("guidance_rates")
}

// AI-drafted listings waiting for human review (Approval Queue). Created by Quick Add (pasted
// brochure text or a URL) and, once a permitted source exists, the Project Finder. Never shown
// publicly: approving one (all 10 checklist items ticked) creates an approved, verified
// Property that appears on /buy. Price is only filled when the source text states it, and then
// carries that source's link and date.
model ListingDraft {
  id                 String    @id @default(cuid())
  origin             String    // quick_add_text | quick_add_url | rera_feed
  sourceName         String?
  sourceUrl          String?
  fetchedAt          DateTime  @default(now())
  rawText            String?   @db.Text
  reraNumber         String?   @unique
  projectName        String
  builder            String?
  location           String?
  city               String?
  state              String?
  propertyType       String    @default("apartment")
  configuration      String?   // e.g. "2 & 3 BHK"
  sizeText           String?   // e.g. "1,250 – 1,890 sq.ft"
  sizeSqft           Float?
  projectStatus      String?   // under construction | ready to move | new launch
  possessionDate     String?
  price              Float?    // total price in currency, only when the source states it
  currency           String    @default("INR")
  priceSourceUrl     String?
  priceSourceDate    DateTime?
  description        String?   @db.Text
  checklist          Json      @default("[]") // 10 booleans, CHECKLIST_ITEMS order
  // Venture Quick Add: the approval the owner supplied (RERA / HMDA / DTCP LP number), uploaded
  // photo ids (UploadedFile, JSON array) and the price as the owner states it (e.g. per sq.yd).
  approvalAuthority  String?
  approvalNumber     String?
  photoIds           String    @default("[]") @db.Text
  priceNote          String?
  aiPriceCheck       Json?     // engine verdict on the stated price, with its date
  reviewStatus       String    @default("draft") // draft | approved | rejected
  rejectReason       String?
  reviewedBy         String?
  reviewedAt         DateTime?
  propertyId         String?   // the Property created on approval
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([reviewStatus, createdAt])
  @@map("listing_drafts")
}

// Real-estate developments collected daily by the news cron (Task H): headline, link, source
// and date only -- source text is kept just long enough for the AI to write an ORIGINAL article
// and is never published. De-duplicated by URL.
model NewsItem {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  sourceName  String
  kind        String    // rbi | pib | rera | report | news
  publishedAt DateTime?
  fetchedAt   DateTime  @default(now())
  snippet     String?   @db.Text
  relevance   Int       @default(0)
  markets     String[]
  postId      String?   // the BlogPost it was used in

  @@index([fetchedAt])
  @@index([relevance])
  @@map("news_items")
}

// Blog Studio: AI-drafted articles (daily news + weekly Market Pulse). Nothing is public until
// the admin approves; citations carry every fact's source link and date.
model BlogPost {
  id            String    @id @default(cuid())
  slug          String    @unique
  kind          String    // news | market_pulse
  title         String
  excerpt       String
  body          String    @db.Text
  whatItMeans   String    @db.Text
  citations     Json      @default("[]") // [{ title, url, source, date, quote? }]
  relatedLinks  Json      @default("[]") // [{ label, href }]
  socialDrafts  Json?     // { instagram, linkedin } captions for Content Studio, drafts only
  status        String    @default("draft") // draft | published | rejected
  rejectReason  String?
  reviewedBy    String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, publishedAt])
  @@map("blog_posts")
}

// Podcast (Task I). One row of show-level settings for the RSS feed, and the episodes. An
// episode starts as an AI-suggested "idea" (planner), becomes a "draft" once the owner uploads
// the recorded MP3 (AI drafts transcript, notes, chapters for editing), and is public only when
// "published" by the owner.
model PodcastShow {
  id          String   @id @default("show")
  title       String   @default("The PropKnown Podcast")
  description String   @default("")
  coverUrl    String?  // square artwork, 1400-3000 px, hosted in Vercel Blob
  ownerName   String   @default("Pinnelli Raghukiran")
  ownerEmail  String   @default("")
  category    String   @default("Business")
  language    String   @default("en-in")
  updatedAt   DateTime @updatedAt

  @@map("podcast_show")
}

model PodcastEpisode {
  id           String    @id @default(cuid())
  slug         String    @unique
  status       String    @default("idea") // idea | draft | published | archived
  title        String
  description  String    @default("")      // SEO description / RSS summary
  outline      String?   @db.Text          // planner talking points (ideas)
  showNotes    String?   @db.Text
  chapters     Json      @default("[]")    // [{ start: "00:00", title }]
  transcript   String?   @db.Text
  guest        String?
  topic        String?
  audioUrl     String?
  audioBytes   Int?
  durationSec  Int?
  relatedLinks Json      @default("[]")    // [{ label, href }]
  socialDrafts Json?                       // { instagram, linkedin, reelScript, whatsapp } drafts
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, publishedAt])
  @@map("podcast_episodes")
}

// M5: AI Document Checker + vault. The file itself is an UploadedFile (isPrivate = true, never
// served publicly); this row holds the preliminary AI review and the human review status.
// Everything is deleted after 30 days (expiresAt) by the daily cleanup job, or sooner on request.
model DocumentCheck {
  id            String    @id @default(cuid())
  buyerId       String
  buyer         BuyerUser @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  fileId        String
  fileName      String
  mimeType      String
  sizeBytes     Int
  docType       String // what the customer says it is, e.g. sale_deed, ec, approval
  status        String    @default("analysing") // analysing | done | failed
  result        Json?
  error         String?
  injectionFlag Boolean   @default(false) // the document contained text aimed at an AI system
  reviewStatus  String    @default("pending") // pending | reviewed
  reviewNotes   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())

  @@index([buyerId])
  @@index([expiresAt])
  @@index([reviewStatus])
  @@map("document_checks")
}

// M7: infrastructure shown on area pages. ONLY entries an admin adds by hand from a verified
// source (government order, authority website, official press release) -- never scraped or
// AI-generated. Each row carries its source and the date it was checked.
model InfraProject {
  id           String   @id @default(cuid())
  name         String
  kind         String // metro | rail | road | airport | it_park | hospital | school | other
  status       String // announced | approved | under_construction | completed
  citySlug     String
  areaSlugs    String // comma-separated area slugs it serves, e.g. "kokapet,narsingi"
  expected     String? // as stated by the source, e.g. "Dec 2027"
  sourceName   String
  sourceUrl    String
  verifiedBy   String
  verifiedAt   DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([citySlug])
  @@map("infra_projects")
}

// M12: WhatsApp on Meta's official WhatsApp Cloud API (no BSP). A contact can only receive
// business-initiated messages after explicit, logged consent; "STOP" opts out immediately.
model WhatsAppContact {
  phone             String    @id // digits only, with country code (e.g. 919876543210)
  leadId            String?
  name              String?
  consentAt         DateTime?
  consentSource     String? // where consent was given, e.g. "price-check form"
  consentText       String? // the exact wording the person agreed to
  consentIp         String?
  optedOutAt        DateTime?
  aiEnabled         Boolean   @default(true)
  humanTakeoverAt   DateTime?
  lastInboundAt     DateTime? // opens Meta's 24-hour window for free-form replies
  followupStep      Int       @default(0) // 0 none, 1 welcome sent, 2 day-2 sent, 3 day-5 sent
  followupStartedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([leadId])
  @@map("whatsapp_contacts")
}

model WhatsAppMessage {
  id           String    @id @default(cuid())
  phone        String
  leadId       String?
  direction    String // in | out
  kind         String // text | template | other
  body         String?   @db.Text
  templateName String?
  waMessageId  String?   @unique
  status       String // received | sent | delivered | read | failed | blocked
  error        String?
  byAi         Boolean   @default(false)
  sentBy       String?
  createdAt    DateTime  @default(now())
  statusAt     DateTime?

  @@index([phone, createdAt])
  @@map("whatsapp_messages")
}

model WhatsAppTemplate {
  id          String    @id @default(cuid())
  name        String    @unique // lowercase_with_underscores, as Meta requires
  language    String    @default("en")
  category    String // MARKETING | UTILITY
  body        String    @db.Text // with {{1}}, {{2}} placeholders
  example     Json? // sample values for the placeholders (Meta needs them)
  status      String    @default("draft") // draft | PENDING | APPROVED | REJECTED | PAUSED
  metaId      String?
  reason      String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("whatsapp_templates")
}
